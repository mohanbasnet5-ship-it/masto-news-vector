{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Queue — show post queue",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/nepalpulse/dev.py",
      "args": ["queue"],
      "cwd": "${workspaceFolder}/nepalpulse",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "▶ Format article (enter ID)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/nepalpulse/dev.py",
