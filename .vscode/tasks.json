      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "group": "build"
    },
    {
      "label": "NP: Daemon — check running",
      "type": "shell",
      "command": "ps -A | grep 'main.py' | grep -v grep || echo 'DAEMON NOT RUNNING'",
      "presentation": { "reveal": "always", "panel": "shared", "clear": false },
      "group": "none"
    },
    {
      "label": "NP: Tail live log",
      "type": "shell",
      "command": "tail -f nepalpulse/logs/nepalpulse_$(date +%Y%m%d).log",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "isBackground": true,
      "problemMatcher": [],
      "group": "none"
    }
