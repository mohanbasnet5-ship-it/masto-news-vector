      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "group": "test"
    },
    {
      "label": "NP: Syntax check all",
      "type": "shell",
      "command": "python3 -m py_compile main.py config/settings.py database/db.py poster/poster.py formatter/formatter.py scanner/scanner.py scanner/gov_scanner.py validator/validator.py illustrator/meridian_card.py illustrator/civic_cards.py weekly/weekly.py alerter/alerter.py web/app.py dev.py && echo '✅ All files OK'",
