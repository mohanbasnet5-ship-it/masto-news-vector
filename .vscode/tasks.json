{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NP: Queue",
      "type": "shell",
      "command": "python3 dev.py queue",
      "options": { "cwd": "${workspaceFolder}/nepalpulse" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "group": "none"
    },
    {
      "label": "NP: Format last article",
      "type": "shell",
